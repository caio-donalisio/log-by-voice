# Bot token, obtained from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (NOT your @username).
# Find it by sending a message to the @userinfobot bot.
ALLOWED_TELEGRAM_USER_ID=

# Folders on the Windows disk, accessed via /mnt/<letter> from WSL.
# Adjust to your own paths.
AUDIO_LOGS_DIR=/home/youruser/log-by-voice/audio_logs
OBSIDIAN_VAULT_DIR=/mnt/d/Path/To/Your/Obsidian Vault

# Local Whisper model (faster-whisper). Bigger = more accurate but slower/heavier.
#   tiny    — ~75MB,  fastest, low accuracy — quick tests only
#   base    — ~150MB, still fast, noticeably better than tiny
#   small   — ~500MB, good balance for CPU-only setups
#   medium  — ~1.5GB, solid accuracy, reasonable on a modern CPU or any GPU
#   large-v3 — ~3GB,  best accuracy, wants a GPU for reasonable latency
WHISPER_MODEL_SIZE=medium
# Language the bot transcribes/classifies. See the "Language" section in
# README.md — this only controls Whisper transcription; the LLM
# classification prompt (prompt_classify.txt) and the regex patterns
# (patterns.py) are hardcoded for Portuguese today, so changing this alone
# does not make the bot support another language end-to-end.
WHISPER_LANGUAGE=pt

# Local timezone used to decide which daily note the transcript goes into
LOCAL_TIMEZONE=America/Sao_Paulo

# Local LLM via Ollama. Install with `curl -fsSL https://ollama.com/install.sh | sh`
# then pull a model: `ollama pull gemma4:e2b` (or any alternative below).
# Tested models, roughly fastest → most capable:
#   llama3.2:3b   — ~2GB,  fastest, usable even CPU-only, lower classification accuracy
#   llama3.1:8b   — ~4.7GB, good quality/speed balance, decent in pt-BR
#   qwen2.5:7b    — ~4.4GB, strong multilingual support, including Portuguese
#   mistral:7b    — ~4GB,  good instruction following
#   gemma2:9b     — ~5.4GB, Google alternative, good quality
#   gemma4:e2b    — ~7.2GB, best accuracy of the tested models; wants a GPU
#                   (~87 tok/s on an RTX 2060) — on CPU only, expect 45-60s/call
LOCAL_LLM_MODEL=gemma4:e2b
OLLAMA_HOST=http://localhost:11434
LOCAL_LLM_TIMEOUT_SECONDS=120
