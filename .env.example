# Token do bot, pego com o @BotFather
TELEGRAM_BOT_TOKEN=

#Seu user id numérico do Telegram (NÃO é o @username).
# Descubra mandando uma mensagem para o bot @userinfobot.
ALLOWED_TELEGRAM_USER_ID=

# Pastas no disco Windows, acessadas via /mnt/<letra> pelo WSL.
# Ajuste se a estrutura de pastas mudar.
AUDIO_LOGS_DIR=/home/caiod/telegram_audio_bot/audio_logs
OBSIDIAN_VAULT_DIR=/mnt/d/Coisas/Outros/Variados/Obsidian Vault

# Modelo Whisper local (faster-whisper). Opções: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=medium
WHISPER_LANGUAGE=pt

# Fuso horário local usado para decidir em qual nota diária a transcrição entra
LOCAL_TIMEZONE=America/Sao_Paulo

# Caminho do executável do Claude Code CLI dentro do WSL. Se `claude` já
# estiver no PATH (confira com `claude --version`), pode deixar como está.
CLAUDE_CLI_PATH=claude
CLAUDE_TIMEOUT_SECONDS=180
